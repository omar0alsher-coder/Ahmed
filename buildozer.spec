[app]
title = Ahmed
package.name = ahmed
package.domain = org.ahmed
source.dir = .
source.include_exts = py,html,css,js,json,png,jpg
version = 1.0.0
requirements = python3,flask,requests
orientation = portrait
fullscreen = 0
android.permissions = INTERNET
android.api = 33
android.minapi = 21
android.ndk = 25b
android.accept_sdk_license = True
p4a.bootstrap = webview
p4a.port = 5000

[buildozer]
log_level = 2
warn_on_root = 1
